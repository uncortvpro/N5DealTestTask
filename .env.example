# Copy to .env and adjust before running `docker compose up --build`.
# JWT_SECRET signs session cookies — use a long random string in any
# real deployment. Docker Compose reads this file automatically.
JWT_SECRET=change-me-to-a-long-random-string

# Optional. Powers the LLM "why this matches" note on the asset detail page
# (apps/api/src/routes/assets.ts). Get one at console.anthropic.com — without
# it, the feature just doesn't render (no error), everything else still works.
ANTHROPIC_API_KEY=
