# Builds and runs the @n5deal/api service.
# Build context is the monorepo root: docker build -f docker/Dockerfile.api .
FROM node:20-alpine AS base
RUN apk add --no-cache openssl && corepack enable

FROM base AS builder
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/api apps/api

RUN pnpm --filter @n5deal/shared build
RUN pnpm --filter @n5deal/api prisma:generate
RUN pnpm --filter @n5deal/api build

# Kept as a single image with devDependencies (incl. tsx, prisma CLI) rather
# than a pruned prod-only stage: the entrypoint needs `prisma migrate deploy`
# and the ts-node-style seed script at container start. Trades image size for
# a simpler, more reliable multi-stage build within the prototype's time box.
FROM base AS runner
WORKDIR /repo
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder /repo ./
RUN chown -R app:app /repo
USER app

WORKDIR /repo/apps/api
EXPOSE 4000
ENTRYPOINT ["sh", "docker-entrypoint.sh"]
