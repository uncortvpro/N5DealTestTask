# Builds and runs the @n5deal/web (Next.js) service.
# Build context is the monorepo root: docker build -f docker/Dockerfile.web .
FROM node:20-alpine AS base
RUN corepack enable

FROM base AS builder
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

COPY packages/shared packages/shared
COPY apps/web apps/web

RUN pnpm --filter @n5deal/shared build
# Next.js resolves next.config.mjs `rewrites()` at build time and bakes the
# result into the production output — setting API_INTERNAL_URL only at
# `docker compose up` runtime does NOT change it, so it must be provided here.
ARG API_INTERNAL_URL=http://api:4000
ENV API_INTERNAL_URL=$API_INTERNAL_URL
RUN pnpm --filter @n5deal/web build

FROM base AS runner
WORKDIR /repo
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder /repo ./
RUN chown -R app:app /repo
USER app

WORKDIR /repo/apps/web
EXPOSE 3000
ENV PORT=3000
CMD ["pnpm", "exec", "next", "start", "-p", "3000"]
