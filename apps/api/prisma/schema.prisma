generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AssetStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

// Sector/Region used to be fixed enums. They're now manager-editable rows —
// `key` is the stable, immutable identifier every reference (Asset,
// BuyerSector/BuyerRegion) stores and joins against; `label` is the only
// thing a manager edits, and `active` is a soft toggle so retiring a value
// hides it from new selections without orphaning assets/profiles that
// already reference it.
model Sector {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assets       Asset[]
  buyerSectors BuyerSector[]
}

model Region {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assets       Asset[]
  buyerRegions BuyerRegion[]
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  role         Role
  name         String
  company      String?
  phone        String?
  status       UserStatus @default(ACTIVE)
  statusReason String?
  statusChangedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  buyerProfile      BuyerProfile?
  assets            Asset[]          @relation("SellerAssets")
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages          Message[]
  favorites         Favorite[]
  matchExplanations MatchExplanation[]

  @@index([role])
  @@index([status])
}

model BuyerProfile {
  userId            Int      @id
  investmentThesis  String   @db.Text
  ticketSizeMin     Int
  ticketSizeMax     Int
  updatedAt         DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectors BuyerSector[]
  regions BuyerRegion[]
}

model BuyerSector {
  id             Int    @id @default(autoincrement())
  buyerProfileId Int
  sector         String

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [userId], onDelete: Cascade)
  sectorRef    Sector       @relation(fields: [sector], references: [key])

  @@unique([buyerProfileId, sector])
}

model BuyerRegion {
  id             Int    @id @default(autoincrement())
  buyerProfileId Int
  region         String

  buyerProfile BuyerProfile @relation(fields: [buyerProfileId], references: [userId], onDelete: Cascade)
  regionRef    Region       @relation(fields: [region], references: [key])

  @@unique([buyerProfileId, region])
}

model Asset {
  id           Int         @id @default(autoincrement())
  sellerId     Int
  title        String
  description  String      @db.Text
  sector       String
  region       String
  dealSize     Int
  revenue      Int?
  ebitda       Int?
  status       AssetStatus @default(ACTIVE)
  statusReason String?
  statusChangedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  seller        User           @relation("SellerAssets", fields: [sellerId], references: [id], onDelete: Cascade)
  sectorRef     Sector         @relation(fields: [sector], references: [key])
  regionRef     Region         @relation(fields: [region], references: [key])
  conversations Conversation[]
  favorites     Favorite[]
  matchExplanations MatchExplanation[]

  @@index([sector])
  @@index([region])
  @@index([status])
}

// LLM-generated "why this matches" text, cached per (buyer, asset) pair so
// the model is only called once per pair instead of on every page view.
// Invalidated (deleted) whenever the buyer edits their profile, since the
// explanation is only valid for the profile it was generated against.
model MatchExplanation {
  id        Int      @id @default(autoincrement())
  buyerId   Int
  assetId   Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([buyerId, assetId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  buyerId   Int
  assetId   Int
  createdAt DateTime @default(now())

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([buyerId, assetId])
}

model Conversation {
  id             Int      @id @default(autoincrement())
  buyerId        Int
  sellerId       Int
  assetId        Int?
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  asset    Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([buyerId, sellerId, assetId])
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int
  senderId       Int
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, readAt])
}
